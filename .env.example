# Application
APP_NAME=PaisaPilot
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Database
# Use PostgreSQL in production: postgresql://USER:PASSWORD@HOST:5432/paisapilot
# Or local SQLite file for zero-config single-node setup: sqlite:./database/paisapilot.db
DATABASE_URL=sqlite:./database/paisapilot.db

# Authentication & Encryption (generate long random 32+ char strings in production)
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_AUTH_SECRET_MIN_32_CHARS
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_OR_BASE64_ENCRYPTION_KEY

# Gemini AI (server-side only; never expose to browser)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3-flash-preview

# Brevo Transactional Email (server-side only)
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=PaisaPilot
BREVO_WEBHOOK_SECRET=OPTIONAL_WEBHOOK_SECRET

# Protected Cron Endpoint Secret (for external managed schedulers)
CRON_SECRET=REPLACE_WITH_RANDOM_CRON_SECRET

# Optional Redis (only if using external queue)
# REDIS_URL=redis://localhost:6379
